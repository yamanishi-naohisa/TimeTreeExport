# TimeTree API認証情報
# TimeTreeのAPIトークンを設定してください
TIMETREE_ACCESS_TOKEN=your_access_token_here

# カレンダーID（特定のカレンダーのみ取得する場合）
# 空欄の場合は全てのカレンダーから取得
TIMETREE_CALENDAR_ID=

# APIベースURL（必要に応じて変更）
TIMETREE_API_BASE_URL=https://timetreeapis.com/v1

# 出力設定
# CSVファイルの出力先ディレクトリ（デフォルト: カレントディレクトリ）
OUTPUT_DIR=.

# CSVファイル名のプレフィックス
OUTPUT_FILENAME_PREFIX=timetree_export

# ログ設定
LOG_LEVEL=INFO
DEBUG_MODE=False

