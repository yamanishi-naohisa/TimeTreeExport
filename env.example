# TimeTree 認証情報
# TimeTreeにログインするためのメールアドレスとパスワードを設定してください
TIMETREE_EMAIL=your_email@example.com
TIMETREE_PASSWORD=your_password

# カレンダーID（特定のカレンダーのみ取得する場合）
# 空欄の場合は全てのカレンダーから取得
TIMETREE_CALENDAR_ID=

# TimeTree Web URL（通常は変更不要）
TIMETREE_BASE_URL=https://timetreeapp.com

# 出力設定
# CSVファイルの出力先ディレクトリ（デフォルト: カレントディレクトリ）
OUTPUT_DIR=.

# CSVファイル名のプレフィックス
OUTPUT_FILENAME_PREFIX=timetree_export

# ブラウザ設定
# False=ブラウザを表示（デバッグ用）、True=非表示（ヘッドレスモード）
BROWSER_HEADLESS=False
# ブラウザのタイムアウト（ミリ秒）
BROWSER_TIMEOUT=30000
# 要素の待機時間（秒）
BROWSER_WAIT_TIME=2
# デバッグ用：処理終了後もブラウザを開いたままにする（True/False）
BROWSER_KEEP_OPEN=False

# ログ設定
LOG_LEVEL=INFO
DEBUG_MODE=False

